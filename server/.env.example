# Copy to server/.env before running: cp server/.env.example server/.env
# Never commit server/.env.

# --- Database (docker-compose.yml creates both databases) ---
DATABASE_URL=postgresql://papertrail:papertrail@localhost:5432/papertrail?schema=public
# Used only by integration tests (pnpm test) so tests never touch dev data.
DATABASE_URL_TEST=postgresql://papertrail:papertrail@localhost:5432/papertrail_test?schema=public

# --- Server ---
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Auth (used from Slice 1) ---
# Generate a real one for anything non-local: openssl rand -hex 32
# Must be at least 32 characters (validated by config/env.ts).
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
COOKIE_SECURE=false
# Session lifetime in days. Single source of truth for JWT expiry
# (seconds) and cookie Max-Age (milliseconds).
SESSION_TTL_DAYS=7

# --- Rate limiting (used from Slice 1; auth + AI routes) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
# Market routes are authenticated, so this limit is per user id, not per IP.
RATE_LIMIT_MARKET_MAX=120

# --- Wallet (used from Slice 1) ---
# 10,00,000 rupees expressed in paise (1 rupee = 100 paise).
STARTING_BALANCE_PAISE=100000000

# --- Market data (used from Slice 2) ---
MARKET_PROVIDER=yahoo
PRICE_POLL_INTERVAL_SECONDS=10
# Cache freshness in market hours; must be >= 2x PRICE_POLL_INTERVAL_SECONDS.
MARKET_CACHE_TTL_SECONDS=120
MAX_PRICE_AGE_SECONDS=120
ALLOW_AFTER_HOURS_TRADING=false

# --- AI (used from Slice 7; leave empty for now) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
AI_RATE_LIMIT_PER_HOUR=20
